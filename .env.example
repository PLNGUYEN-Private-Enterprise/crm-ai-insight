# Build-time (set as build variables in Cloudflare Workers Builds, or in .env.local for `next dev`)
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Optional — when set, "Book a discovery call" opens this link instead of scrolling to the form.
NEXT_PUBLIC_BOOKING_URL=
# Optional — shown next to the contact form and in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=

# Runtime secrets (`npx wrangler secret put <NAME>`, or .dev.vars for `npm run preview`)
CONTACT_WEBHOOK_URL=https://your-n8n-host/webhook/website-contact
CONTACT_WEBHOOK_SECRET=
